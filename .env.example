# Copie para .env e preencha. O .env NUNCA e versionado.
#
# Nenhuma destas chaves pode chegar ao navegador. Em especial a API_BASE_URL: o ponto da
# arquitetura BFF e que o JavaScript so conhece rotas relativas (/leads/list), e quem
# traduz para a API e o PHP. URL de API em atributo data-* ou em arquivo .js anula isso.

# --- API -------------------------------------------------------------------------------
API_BASE_URL=https://api-leads.digite.com.br

# Segundos. Baixo de proposito: uma tela travada esperando 60s e pior para o operador do
# que um erro claro em 15s, que ele pode repetir.
API_TIMEOUT=15

# --- Sessao ----------------------------------------------------------------------------
SESSION_NAME=crm_session

# Segundos. NAO e a validade do JWT -- essa vem de expiresAtUtc, emitida pela API, e o
# ApiClient a compara com o relogio antes de cada chamada. Este valor governa apenas o
# cookie do PHP, e manter os dois proximos evita a sessao viva com token morto.
SESSION_LIFETIME=3600

# --- Aplicacao -------------------------------------------------------------------------
APP_ENV=production

# false em producao. O traceId de um 5xx pode aparecer na tela para o suporte correlacionar;
# o stack trace, nunca.
APP_DEBUG=false
