# Copie para .env e preencha. O .env NUNCA e versionado.
#
# Nenhuma destas chaves pode chegar ao navegador. Em especial a API_BASE_URL: o ponto da
# arquitetura BFF e que o JavaScript so conhece rotas relativas (/leads/list), e quem
# traduz para a API e o PHP. URL de API em atributo data-* ou em arquivo .js anula isso.

# --- API -------------------------------------------------------------------------------
API_BASE_URL=https://api-leads.digite.com.br

# Segundos. Baixo de proposito: uma tela travada esperando 60s e pior para o operador do
# que um erro claro em 15s, que ele pode repetir.
API_TIMEOUT=15

# --- Sessao ----------------------------------------------------------------------------
SESSION_NAME=crm_session

# Segundos. Governa DUAS coisas: a validade do cookie e o session.gc_maxlifetime, que e o
# tempo que o PHP guarda o arquivo de sessao sem acesso.
#
# Precisa ser >= Jwt_ExpiresInSeconds da API (hoje 86400). Menor que isso derruba o usuario
# com um token ainda valido na mao -- e o sintoma aparece como "o token esta expirando
# antes", quando na verdade quem venceu foi a sessao do front.
#
# Maior nao e problema: o ApiClient confere o expiresAtUtc antes de cada chamada e manda ao
# login assim que o token vence.
SESSION_LIFETIME=86400

# --- Aplicacao -------------------------------------------------------------------------
APP_ENV=production

# false em producao. O traceId de um 5xx pode aparecer na tela para o suporte correlacionar;
# o stack trace, nunca.
APP_DEBUG=false
